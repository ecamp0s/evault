# Laravel
# No ignorar aquí storage/ ni bootstrap/cache/: el skeleton de Laravel ya trae
# un .gitignore dentro de cada uno con el patrón * más !.gitignore, que ignora
# el contenido pero mantiene el directorio en el repo. Ignorarlos desde aquí
# pisa ese mecanismo y los directorios desaparecen en un checkout limpio, lo
# que rompe artisan con "directory must be present and writable".
api/vendor/
api/.env

# React
web/node_modules/
web/dist/
web/.env
web/.env.local

# Mobile (futuro)
mobile/node_modules/

# Extension (futuro)
extension/node_modules/
extension/dist/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json

# Claude Code
# Los permisos locales son de cada máquina y acaban conteniendo comandos
# literales, credenciales de desarrollo incluidas. .claude/settings.json sí se
# versiona: son las reglas compartidas del proyecto.
.claude/settings.local.json

/temp

# Configuración local de `docker compose`. El .env.example de la raíz sí se
# versiona: es la referencia de lo que se puede ajustar, y sus valores por
# defecto son los que el compose aplica si este fichero no existe.
/.env