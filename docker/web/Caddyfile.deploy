# Frontal de eVault para un despliegue. Ver ADR-012, ADR-015 y ADR-016.
#
# Es el hermano de ./Caddyfile, que sirve al arranque desde un clon. La diferencia
# no es de estilo: allí los hosts terminan en `.localhost` y el navegador ya los
# considera contexto seguro sin certificado, así que basta `http`. Aquí el
# navegador está en OTRA máquina, y sin `https` no existe `crypto.subtle` — o sea
# que eVault no arranca. No es endurecimiento, es requisito de funcionamiento.
#
# UN SOLO ORIGEN desde el issue #296, igual que en desarrollo y por el mismo motivo.
# El razonamiento está en el fichero hermano y entero en ADR-016.

{
	admin off

	# La CA interna de Caddy emite los certificados del acceso por la red local. No
	# hace falta dominio público, ni abrir puertos, ni Let's Encrypt.
	#
	# El precio, y hay que saberlo antes de desplegar: cada dispositivo desde el
	# que se abra la vault tiene que confiar en esa CA una vez. En iOS son dos
	# pasos separados y el segundo no es evidente. Ver DEPLOYMENT.md.
	#
	# DEJA DE SER OBLIGATORIO cuando el acceso va por Tailscale, que sirve un
	# certificado en el que cualquier dispositivo confía sin instalar nada. Este
	# camino se conserva a propósito para que la vault siga abriéndose desde la red
	# local aunque un tercero esté caído: es la decisión 4 de ADR-015.
	#
	# La CA vive en /data, que el compose de despliegue persiste en un volumen. Sin
	# ese volumen, recrear el contenedor generaría una CA nueva y habría que volver
	# a instalarla en todos los dispositivos.
	local_certs
}

# El cuerpo es idéntico para los dos nombres por los que se sirve la vault, así que
# vive en un snippet: duplicarlo sería garantizar que un día divergen y que solo se
# note por uno de los dos caminos.
(evault) {
	encode gzip

	# El porqué de este orden y de `handle` frente a `handle_path` está en el
	# Caddyfile de desarrollo, y resumido: si el `try_files` de la SPA atrapara
	# `/api/...`, la respuesta sería el index.html con un 200 en vez de un error de
	# la API. Y las rutas de Laravel ya empiezan por `/api`, así que el prefijo se
	# conserva.
	handle /api/* {
		root * /var/www/html/public
		php_fastcgi api:9000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# 1) La red local, con la CA interna. No depende de ningún tercero, y por eso se
#    conserva: es la decisión 4 de ADR-015.
https://{$APP_HOST} {
	tls internal
	import evault
}

# 2) El nombre de la tailnet, que es el que sirve DESDE FUERA de la red local.
#
#    Sin bloque `tls`: Caddy reconoce los dominios `.ts.net` y pide el certificado al
#    demonio local de Tailscale en el propio handshake, renovándolo él solo. Eso es lo
#    que ADR-016 §2.2 eligió frente a `tailscale cert` a fichero con un cron, que es
#    el modo de fallo de #264 y #265 — algo que se rompe sin producir ningún efecto
#    visible hasta el día que hace falta.
#
#    El nombre NO está escrito aquí y no es descuido: es un dato de la red doméstica y
#    este repositorio es público. Llega por `TAILSCALE_HOST` desde compose.tailscale.yaml.
#
#    El valor por defecto es `localhost` para que este fichero siga siendo válido en un
#    despliegue SIN Tailscale, donde ese bloque sirve un nombre que nadie pide. La
#    alternativa —un Caddyfile aparte— habría duplicado el cuerpo, que es justo lo que
#    el snippet de arriba evita.
https://{$TAILSCALE_HOST:localhost} {
	import evault
}
