# URL base de la API. Sin barra final.
# Obligatoria: la SPA no asume ningún dominio, porque el mismo build tiene que
# servir a cualquier despliegue self-hosted. Ver ADR-005.
#
# El valor por defecto es el de `php artisan serve`, que es lo que encuentra quien
# clona el repositorio y sigue el arranque del README. El entorno de desarrollo de
# este proyecto usa http://api.evault.claude/api; ver docs/development/SETUP.md.
VITE_API_URL=http://localhost:8000/api
