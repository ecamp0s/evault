#!/usr/bin/env bash
#
# Refuses a direct push to master.
#
# WHAT COVERS WHAT, because there are two things and they are not the same one.
#
# The RULESET, on the server and with no way around it, covers what cannot be
# undone: deleting `master` and rewriting its history. It exists since the
# repository became public and it closed issue #21 on 3 August 2026.
#
# THIS HOOK, in your clone and skippable with --no-verify, covers what the ruleset
# leaves out: the slip of pushing straight to master instead of to the issue's
# branch, and the accidental force push. It protects against absent-mindedness, not
# against anyone acting in bad faith — that is the ruleset's job.
#
# AND THE RULESET DOES NOT DEMAND PULL REQUESTS, which is why this is still here.
# GitHub does not allow granting bypass to GitHub Actions on a personal repository,
# only on organisations, and the `status` workflow writes STATUS.md to master with
# the GITHUB_TOKEN: with that rule on, the push dies with GH013. Requiring a PR and
# regenerating STATUS.md automatically are incompatible today, and keeping the
# automation is what was chosen. So the direct push is covered by this and nothing
# else.
#
# It does not get in the way of the normal flow. A pull request is merged by GitHub
# on the server, not by a push from here, so `gh pr merge` keeps working.
#
# Turn it on with:
#   git config core.hooksPath scripts/hooks
#
set -euo pipefail

readonly PROTECTED_BRANCH='master'
readonly NULL_SHA='0000000000000000000000000000000000000000'

while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/${PROTECTED_BRANCH}" ] || continue

    if [ "$local_sha" = "$NULL_SHA" ]; then
        reason="Estás intentando BORRAR ${PROTECTED_BRANCH}."
    elif [ "$remote_sha" != "$NULL_SHA" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        reason="Estás intentando hacer FORCE PUSH sobre ${PROTECTED_BRANCH}, lo que reescribiría el historial."
    else
        reason="Estás intentando pushear directamente a ${PROTECTED_BRANCH}."
    fi

    cat >&2 <<FIN

  ✖ Push rechazado

  ${reason}

  El flujo del proyecto es una rama por issue y merge con squash desde un pull
  request. Si estabas en master por descuido, lo que quieres es algo así:

      git switch -c <tipo>/<numero>-descripcion
      git push -u origin <tipo>/<numero>-descripcion
      gh pr create

  Si de verdad necesitas saltártelo, --no-verify lo permite. Esto es una red
  local; lo irreversible --borrar master o reescribir su historia-- lo impide
  el ruleset del servidor, que no depende de este clon y no se salta.

FIN
    exit 1
done

exit 0
